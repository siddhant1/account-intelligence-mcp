# ----------------------------------------------------------------------------
# Account Intelligence MCP server - example configuration
# Copy to .env and adjust. Every value is optional in development.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info            # trace | debug | info | warn | error | silent
# LOG_PRETTY=true         # default: pretty when NODE_ENV=development and stderr is a terminal

# HTTP transport
HOST=127.0.0.1
PORT=3100
# Base URL used in export download links (default: http://localhost:$PORT)
# PUBLIC_BASE_URL=https://mcp.example.com
# Host headers accepted by the server (DNS-rebinding protection).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Browser origins allowed to call the server (CORS). Origins on ALLOWED_HOSTS are always allowed.
# ALLOWED_ORIGINS=https://inspector.example.com

# Storage (relative paths resolve from the project root, not the current directory)
DATABASE_PATH=./data/account-intel.db

# Rate limiting: authenticated requests per API key per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Failed authentication attempts allowed per IP per 15 minutes
AUTH_FAILURE_LIMIT=20

# Exports: signed download links
EXPORT_URL_TTL_SECONDS=900
# Required (32+ chars) when NODE_ENV=production
EXPORT_SIGNING_SECRET=dev-only-export-signing-secret-change-me

# Simulated enrichment provider latency (ms)
ENRICHMENT_LATENCY_MS=150

# ----------------------------------------------------------------------------
# Development API keys, created by `npm run db:seed` (never in production).
# Create real keys with `npm run keys -- create --name <client>`.
# ----------------------------------------------------------------------------
DEV_API_KEY=aip_dev_7BOfCrBZudqCbpIsM29yMjCxq92xgGxs
DEV_READONLY_API_KEY=aip_dev_O49HyGKPL5yBnQ0kCLM5ZxkCdJklSkLJ

# Used by the stdio entrypoint (Claude Desktop local mode) and the demo client.
ACCOUNT_INTEL_API_KEY=aip_dev_7BOfCrBZudqCbpIsM29yMjCxq92xgGxs
