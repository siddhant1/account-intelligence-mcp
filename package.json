{
  "name": "account-intelligence-mcp",
  "version": "1.0.0",
  "description": "MCP server for an Account Intelligence Platform: search companies, look up contacts, enrich and export them.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx src/cli/seed.ts",
    "keys": "tsx src/cli/keys.ts",
    "demo": "tsx scripts/demo-client.ts",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}
